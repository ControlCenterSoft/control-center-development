{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.local/api/capacity-placement-advice-reuse-decision-v1.schema.json",
  "title": "Capacity Placement Advice Reuse Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "revalidation_id",
    "snapshot_id",
    "placement_snapshot_id",
    "current_placement_snapshot_id",
    "provenance_snapshot_id",
    "current_provenance_snapshot_id",
    "derivation_fingerprint",
    "current_derivation_fingerprint",
    "status",
    "reason",
    "recommended_action",
    "reuse_allowed",
    "advisory_only",
    "placement_authorized",
    "production_mutation"
  ],
  "properties": {
    "schema_version": {"const": "capacity.placement-advice-reuse-decision/v1"},
    "decision_id": {"type": "string", "pattern": "^pard-[a-f0-9]{24}$"},
    "revalidation_id": {"type": "string", "pattern": "^padr-[a-f0-9]{24}$"},
    "snapshot_id": {"type": "string", "pattern": "^pade-[a-f0-9]{24}$"},
    "current_snapshot_id": {"type": "string", "pattern": "^pade-[a-f0-9]{24}$"},
    "placement_snapshot_id": {"type": "string", "pattern": "^pas-[a-f0-9]{24}$"},
    "current_placement_snapshot_id": {"type": "string", "pattern": "^pas-[a-f0-9]{24}$"},
    "provenance_snapshot_id": {"type": "string", "minLength": 1},
    "current_provenance_snapshot_id": {"type": "string", "minLength": 1},
    "derivation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "current_derivation_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["allowed", "blocked"]},
    "reason": {"type": "string", "minLength": 1},
    "recommended_action": {"type": "string", "minLength": 1},
    "reuse_allowed": {"type": "boolean"},
    "advisory_only": {"const": true},
    "placement_authorized": {"const": false},
    "production_mutation": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "allowed"}}, "required": ["status"]},
      "then": {
        "required": ["current_snapshot_id"],
        "properties": {
          "reason": {"const": "exact-current-derived-evidence-reusable"},
          "recommended_action": {"const": "none"},
          "reuse_allowed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "blocked"}}, "required": ["status"]},
      "then": {
        "properties": {
          "reuse_allowed": {"const": false},
          "recommended_action": {"not": {"const": "none"}}
        }
      }
    }
  ]
}
