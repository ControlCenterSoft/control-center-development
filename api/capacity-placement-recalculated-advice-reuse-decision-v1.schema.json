{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.local/api/capacity-placement-recalculated-advice-reuse-decision-v1.schema.json",
  "title": "Capacity Placement Recalculated Advice Reuse Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "revalidation_id",
    "supersession_id",
    "source_derived_snapshot_id",
    "source_placement_snapshot_id",
    "source_advice_id",
    "derived_snapshot_id",
    "placement_snapshot_id",
    "advice_id",
    "headroom_envelope_id",
    "resource_freshness_gate_id",
    "scope_id",
    "checked_at",
    "recommended_node_id",
    "safety_score_band",
    "effective_safety_margin_percent",
    "fresh_advisory_reuse_allowed",
    "source_reuse_authorized",
    "placement_authorized",
    "advisory_only",
    "production_mutation",
    "reason",
    "recommended_action"
  ],
  "properties": {
    "schema_version": {
      "const": "capacity.placement-recalculated-advice-reuse-decision/v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^prard-[a-f0-9]{24}$"
    },
    "revalidation_id": {
      "type": "string",
      "pattern": "^prar-[a-f0-9]{24}$"
    },
    "supersession_id": {
      "type": "string",
      "pattern": "^pras-[a-f0-9]{24}$"
    },
    "source_derived_snapshot_id": {
      "type": "string",
      "pattern": "^pade-[a-f0-9]{24}$"
    },
    "source_placement_snapshot_id": {
      "type": "string",
      "pattern": "^pas-[a-f0-9]{24}$"
    },
    "source_advice_id": {
      "type": "string",
      "pattern": "^pa-[a-f0-9]{24}$"
    },
    "derived_snapshot_id": {
      "type": "string",
      "pattern": "^pade-[a-f0-9]{24}$"
    },
    "placement_snapshot_id": {
      "type": "string",
      "pattern": "^pas-[a-f0-9]{24}$"
    },
    "advice_id": {
      "type": "string",
      "pattern": "^pa-[a-f0-9]{24}$"
    },
    "headroom_envelope_id": {
      "type": "string",
      "pattern": "^prh-[a-f0-9]{24}$"
    },
    "resource_freshness_gate_id": {
      "type": "string",
      "pattern": "^prhg-[a-f0-9]{24}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "recommended_node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "safety_score_band": {
      "const": "headroom"
    },
    "effective_safety_margin_percent": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "fresh_advisory_reuse_allowed": {
      "const": true
    },
    "source_reuse_authorized": {
      "const": false
    },
    "placement_authorized": {
      "const": false
    },
    "advisory_only": {
      "const": true
    },
    "production_mutation": {
      "const": false
    },
    "reason": {
      "const": "current-recalculated-advice-reuse-allowed"
    },
    "recommended_action": {
      "const": "reuse-current-recalculated-advice-for-planning-only"
    }
  }
}
