{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.local/api/capacity-placement-rebuild-evidence-receipt-v1.schema.json",
  "title": "Capacity Placement Rebuild Evidence Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "resource_reuse_gate_id",
    "resource_freshness_gate_id",
    "headroom_envelope_id",
    "derived_snapshot_id",
    "placement_snapshot_id",
    "advice_id",
    "scope_id",
    "checked_at",
    "blocked_by",
    "requirements",
    "required_artifacts",
    "recommended_action",
    "rebuild_required",
    "reuse_authorized",
    "rebuild_authorized",
    "placement_authorized",
    "advisory_only",
    "production_mutation"
  ],
  "properties": {
    "schema_version": {
      "const": "capacity.placement-rebuild-evidence-receipt/v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^prer-[a-f0-9]{24}$"
    },
    "resource_reuse_gate_id": {
      "type": "string",
      "pattern": "^prrg-[a-f0-9]{24}$"
    },
    "resource_freshness_gate_id": {
      "type": "string",
      "pattern": "^prhg-[a-f0-9]{24}$"
    },
    "headroom_envelope_id": {
      "type": "string",
      "pattern": "^prh-[a-f0-9]{24}$"
    },
    "derived_snapshot_id": {
      "type": "string",
      "pattern": "^pade-[a-f0-9]{24}$"
    },
    "placement_snapshot_id": {
      "type": "string",
      "pattern": "^pas-[a-f0-9]{24}$"
    },
    "advice_id": {
      "type": "string",
      "pattern": "^pa-[a-f0-9]{24}$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "blocked_by": {
      "enum": [
        "resource-evidence",
        "lineage"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 65536,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "constraint_id",
          "metric",
          "target_id",
          "current_status",
          "reason",
          "required_evidence"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "constraint_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "metric": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "current_status": {
            "enum": [
              "current",
              "degraded-evidence",
              "stale"
            ]
          },
          "reason": {
            "enum": [
              "constraint-observation-stale",
              "constraint-evidence-not-measured",
              "candidate-confidence-degraded",
              "lineage-revalidation-required"
            ]
          },
          "required_evidence": {
            "enum": [
              "current-measured-telemetry",
              "profile-and-telemetry-lineage"
            ]
          }
        }
      }
    },
    "required_artifacts": {
      "const": [
        "node-projections",
        "derived-placement-evidence",
        "resource-headroom-envelope",
        "resource-freshness-gate",
        "placement-advice"
      ]
    },
    "recommended_action": {
      "const": "collect-evidence-and-rebuild-advice"
    },
    "rebuild_required": {
      "const": true
    },
    "reuse_authorized": {
      "const": false
    },
    "rebuild_authorized": {
      "const": false
    },
    "placement_authorized": {
      "const": false
    },
    "advisory_only": {
      "const": true
    },
    "production_mutation": {
      "const": false
    }
  }
}
