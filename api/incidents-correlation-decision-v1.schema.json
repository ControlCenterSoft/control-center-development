{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://control-center.pro/schemas/incidents-correlation-decision-v1.schema.json",
  "title": "Control Center incident correlation decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "state",
    "fingerprint",
    "execution_authorized",
    "production_mutation_allowed"
  ],
  "properties": {
    "contract": {
      "const": "incidents.correlation-decision/v1"
    },
    "state": {
      "enum": ["match", "already-linked", "new-candidate", "blocked"]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "incident_resource_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "incident_generation": {
      "type": "integer",
      "minimum": 1
    },
    "blockers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "multiple_exact_open_incidents",
          "signal_id_linked_to_multiple_incidents"
        ]
      }
    },
    "execution_authorized": {
      "const": false
    },
    "production_mutation_allowed": {
      "const": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["match", "already-linked"]}
        },
        "required": ["state"]
      },
      "then": {
        "required": ["incident_id", "incident_resource_version", "incident_generation"],
        "not": {"required": ["blockers"]}
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "blocked"}
        },
        "required": ["state"]
      },
      "then": {
        "required": ["blockers"],
        "not": {
          "anyOf": [
            {"required": ["incident_id"]},
            {"required": ["incident_resource_version"]},
            {"required": ["incident_generation"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {"const": "new-candidate"}
        },
        "required": ["state"]
      },
      "then": {
        "not": {
          "anyOf": [
            {"required": ["incident_id"]},
            {"required": ["incident_resource_version"]},
            {"required": ["incident_generation"]},
            {"required": ["blockers"]}
          ]
        }
      }
    }
  ]
}
